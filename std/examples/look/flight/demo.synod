# package main
# Shows look.Flight with net.Id and net.Type: balls fly with each message and land on arrival
use example.com/library/look/flight
use example.com/library/look/pingpong
use std/sim

define main
  set nodes to (sim.Cluster of 2 running pingpong)
  deliver (message pingpong.Start with Peer (item 1 of nodes)) to (item 0 of nodes)
  sim.StopAt 1s
