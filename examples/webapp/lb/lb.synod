# package lb
use github.com/synodlang/examples/webapp/api
use std/lists
use std/net
use std/sim

node has
  set Backends to {}
  set next to 0

define Balance [servers: list] on [n: node]
  set Backends of n to servers

# Round robin over the application servers
when (sim.Delivered api.Get)
  net.Send api.Get to (item next of Backends)
  set next to (next plus 1)
  if (next is (lists.Size Backends))
    set next to 0
