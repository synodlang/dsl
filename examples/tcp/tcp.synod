# package tcp
use std/net
use std/sim

Open has
  set Server to sim.Nobody

Syn has
  set Seq to 0

SynAck has
  set Seq to 0
  set AckNo to 0

Ack has
  set AckNo to 0

node has
  set State to "CLOSED"
  set seq to 0
  set peerSeq to 0

# Client: the application asks to open a connection
when (sim.Delivered Open)
  set seq to 100
  set State to "SYN-SENT"
  net.Send (message Syn with Seq seq) to (Server of Open)

# Server: answer a SYN with SYN-ACK
when (net.Received Syn from client)
  set peerSeq to (Seq of Syn)
  set seq to 300
  set State to "SYN-RECEIVED"
  net.Send (message SynAck with Seq seq, AckNo (peerSeq plus 1)) to client

# Client: a SYN-ACK that acknowledges our SYN completes our side
when (net.Received SynAck from server)
  if ((AckNo of SynAck) is (seq plus 1))
    set peerSeq to (Seq of SynAck)
    set State to "ESTABLISHED"
    net.Send (message Ack with AckNo (peerSeq plus 1)) to server

# Server: the final ACK completes the handshake
when (net.Received Ack from client)
  if ((AckNo of Ack) is (seq plus 1))
    set State to "ESTABLISHED"
