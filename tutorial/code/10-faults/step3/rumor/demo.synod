# package main
use example.com/tutorial/rumor
use std/net
use std/sim

define main
  sim.Seed 4
  net.Loss 0.3
  set nodes to (sim.Cluster of 6 running rumor)
  rumor.Connect nodes
  deliver (message rumor.Rumor with Text "The leader is n1") to (item 0 of nodes)
  after 2s
    sim.Crash (item 2 of nodes)
  after 3s
    sim.Restart (item 2 of nodes)
