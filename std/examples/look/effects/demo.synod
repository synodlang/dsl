# package main
# Shows every look.Effect name and look.MessageColor: a card per effect, and a dot in the color of a message
use example.com/library/look/effects
use example.com/library/look/pingpong
use std/sim

define main
  set nodes to (sim.Cluster of 2 running pingpong)
  deliver (message pingpong.Start with Peer (item 1 of nodes)) to (item 0 of nodes)
  sim.StopAt 1s
