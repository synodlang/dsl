@3s timer n5
  sim.Fired n5
  sim.Ended stop
final:
  n1 up  raft.Role "follower", raft.Term 1, raft.VotedFor n3, raft.Peers {n2, n3, n4, n5}
  n2 up  raft.Role "follower", raft.Term 1, raft.VotedFor n3, raft.Peers {n1, n3, n4, n5}
  n3 up  raft.Role "leader", raft.Term 1, raft.VotedFor n3, raft.Peers {n1, n2, n4, n5}
  n4 up  raft.Role "follower", raft.Term 1, raft.VotedFor n3, raft.Peers {n1, n2, n3, n5}
  n5 up  raft.Role "follower", raft.Term 1, raft.VotedFor n3, raft.Peers {n1, n2, n3, n4}
