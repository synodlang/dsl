# package twopc
use std/lists
use std/net
use std/random
use std/sim

Begin has
  set Tx to 0

Prepare has
  set tx to 0

Vote has
  set tx to 0
  set yes to false

Decision has
  set tx to 0
  set commit to false

node has
  set State to "idle"
  set Participants to {}
  set tx to 0
  set yesVotes to 0

define Coordinate [ps: list] from [c: node]
  set Participants of c to ps

define Decide [commit: bool]
  if commit
    set State to "committed"
  else
    set State to "aborted"
  each p in Participants
    net.Send (message Decision with tx tx, commit commit) to p

# Coordinator, phase 1: ask every participant to prepare
when (sim.Delivered Begin)
  set tx to (Tx of Begin)
  set State to "waiting"
  set yesVotes to 0
  each p in Participants
    net.Send (message Prepare with tx tx) to p
  after 500ms
    if (State is "waiting")
      Decide false

# Participant: vote, and once prepared, wait for the decision
when (net.Received Prepare from coordinator)
  set yes to (random.Chance 0.9)
  if yes
    set State to "prepared"
  else
    set State to "aborted"
  net.Send (message Vote with tx (tx of Prepare), yes yes) to coordinator

# Coordinator, phase 2: commit only if everyone voted yes
when (net.Received Vote from participant)
  if (State is "waiting")
    if (yes of Vote)
      set yesVotes to (yesVotes plus 1)
      if (yesVotes is (lists.Size Participants))
        Decide true
    else
      Decide false

when (net.Received Decision from coordinator)
  if (commit of Decision)
    set State to "committed"
  else
    set State to "aborted"

define Atomic
  set committed to false
  set aborted to false
  each n in (sim.NodesRunning twopc)
    if ((State of n) is "committed")
      set committed to true
    if ((State of n) is "aborted")
      set aborted to true
  result (not (committed and aborted))

# Atomicity: never some nodes committed while others aborted
always Atomic
