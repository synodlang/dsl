run example.com/tutorial/counter seed 1
end: empty at 5s, 2 nodes, 11 steps, 20 events
steps:
@0s main
  sim.Started
  sim.Added n1 runs counter: counter.Count 0
  sim.Added n2 runs counter: counter.Count 0
@0s start n1
  sim.Changed counter.Count of n1 from 0 to 1
@0s start n2
  sim.Changed counter.Count of n2 from 0 to 1
@1s timer n1
  sim.Fired n1
  sim.Changed counter.Count of n1 from 1 to 2
@1s timer n2
  sim.Fired n2
  sim.Changed counter.Count of n2 from 1 to 2
@2s timer n1
  sim.Fired n1
  sim.Changed counter.Count of n1 from 2 to 3
@2s timer n2
  sim.Fired n2
  sim.Changed counter.Count of n2 from 2 to 3
@3s timer main
  sim.Crashed n1
@3s timer n2
  sim.Fired n2
  sim.Changed counter.Count of n2 from 3 to 4
@4s timer n2
  sim.Fired n2
  sim.Changed counter.Count of n2 from 4 to 5
@5s timer main
  sim.Crashed n2
  sim.Ended empty
final:
  n1 down  counter.Count 3
  n2 down  counter.Count 5
