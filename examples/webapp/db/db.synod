# package db
use github.com/synodlang/examples/webapp/api
use std/net
use std/text

node has
  set Queries to 0

# The database is slow: every query takes 40ms of work
when (net.Received api.Query from asker)
  set Queries to (Queries plus 1)
  after 40ms
    net.Send (message api.Rows with Key (Key of api.Query), Id (Id of api.Query), Value (text.Join {"row for ", (Key of api.Query)})) to asker
