# package rumorlook
use std/look
use std/net
use std/sim
use std/theme

# Put the cards on a ring
when sim.Started
  look.Layout "ring"

# One card for each node, attached to the node as "card"
when (sim.Added n)
  draw (look.Card for n) as card for n

# A ball takes off from the sender's card and flies to the receiver's
when (net.Sent m from a to b)
  draw (look.Circle 6) as ball for (net.Id m)
  look.Fill ball with theme.Accent
  look.Flight ball from (card of a) to (card of b) for m

# It lands and disappears
when (net.Arrived m from a to b)
  look.Remove (ball of (net.Id m))
