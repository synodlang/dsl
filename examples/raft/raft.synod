# package raft
use std/lists
use std/math
use std/net
use std/random
use std/sim
use std/time

Elected has
  set Term to 0

RequestVote has
  set term to 0

Vote has
  set term to 0
  set granted to false

Heartbeat has
  set term to 0

node has
  set Role to "follower"
  set Term to 0
  set VotedFor to sim.Nobody
  set Peers to {}
  set votes to 0
  set lastHeard to 0ms

define Meet [ns: list]
  each n in ns
    set Peers of n to (lists.Without n from ns)

define Majority of [n: number]
  result ((math.Floor (n divided by 2)) plus 1)

define Leaders
  set found to {}
  each n in (sim.NodesRunning raft)
    if (((Role of n) is "leader") and (sim.IsUp n))
      set found to (lists.Append n to found)
  result found

define LeadersAgree
  set terms to {}
  each n in (sim.NodesRunning raft)
    if ((Role of n) is "leader")
      if ((Term of n) is in terms)
        result false
      set terms to (lists.Append (Term of n) to terms)
  result true

# Election safety: never two leaders in the same term
always LeadersAgree

define BecomeFollower [t: number]
  set Term to t
  set Role to "follower"
  set VotedFor to sim.Nobody

define StartElection
  set Role to "candidate"
  set Term to (Term plus 1)
  set VotedFor to sim.Here
  set votes to 1
  set lastHeard to time.Now
  each p in Peers
    net.Send (message RequestVote with term Term) to p

# A randomized timeout keeps candidates from colliding forever
define WatchElection
  after (random.TimeBetween 150ms and 300ms)
    if ((Role is not "leader") and ((time.Now minus lastHeard) at least 150ms))
      StartElection
    WatchElection

WatchElection

time.Every 50ms
  if (Role is "leader")
    each p in Peers
      net.Send (message Heartbeat with term Term) to p

when (net.Received RequestVote from candidate)
  if ((term of RequestVote) more than Term)
    BecomeFollower (term of RequestVote)
  set grant to (((term of RequestVote) is Term) and ((VotedFor is sim.Nobody) or (VotedFor is candidate)))
  if grant
    set VotedFor to candidate
    set lastHeard to time.Now
  net.Send (message Vote with term Term, granted grant) to candidate

when (net.Received Vote from voter)
  if ((term of Vote) more than Term)
    BecomeFollower (term of Vote)
  else
    if (((Role is "candidate") and (granted of Vote)) and ((term of Vote) is Term))
      set votes to (votes plus 1)
      if (votes is (Majority of ((lists.Size Peers) plus 1)))
        set Role to "leader"
        emit (message Elected with Term Term)

when (net.Received Heartbeat from leader)
  if ((term of Heartbeat) at least Term)
    if ((term of Heartbeat) more than Term)
      BecomeFollower (term of Heartbeat)
    set Role to "follower"
    set lastHeard to time.Now
